        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">34.10.125.253</domain>
        <domain includeSubdomains="true">3.89.228.24</domain>
        <domain includeSubdomains="true">20.102.51.189</domain>
    </domain-config>
</network-security-config>

